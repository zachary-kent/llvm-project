FROM debian:bookworm

# Install LLVM build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    python3 \
    python3-pip \
    ca-certificates \
    zlib1g-dev \
    libedit-dev \
    libxml2-dev \
    swig \
    doxygen \
    graphviz \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /workspace

# Default command opens a bash shell
CMD ["/bin/bash"]
